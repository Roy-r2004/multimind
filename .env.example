# MultiAI — environment configuration
# Copy to .env and fill in your API keys

# Frontend (Vite / TanStack Start)
VITE_API_URL=/api/v1
VITE_MAPS_CENSUS_ADMIN_ENABLED=true
# Dev proxy + Docker/Render web container runtime proxy to the API
BACKEND_PROXY_TARGET=http://localhost:8000

# Backend
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-use-openssl-rand-hex-32
DATABASE_URL=sqlite+aiosqlite:///./multiai.db
# Docker Compose / Render Postgres example:
# DATABASE_URL=postgresql+asyncpg://multiai:multiai@postgres:5432/multiai
REDIS_URL=redis://localhost:6380/0

# Dedicated Playbook ARQ worker (separate process and queue from scraping/maps).
# Queue default is "playbooks". Scraping/maps uses ARQ's default "arq:queue".
# Concurrency 1 and a 1-hour timeout are infrastructure defaults, not final tuning.
PLAYBOOK_WORKER_QUEUE_NAME=playbooks
PLAYBOOK_WORKER_CONCURRENCY=1
PLAYBOOK_WORKER_JOB_TIMEOUT_SECONDS=3600
PLAYBOOK_WORKER_KEEP_RESULT_SECONDS=3600
# Fixed internal Playbook extraction model (not the user's chat model set).
PLAYBOOK_EXTRACTION_MODEL_ID=gpt-4.1
PLAYBOOK_CORE_SUMMARY_MAX_CHARS=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3080,https://multiai-web.onrender.com
PUBLIC_APP_URL=http://localhost:3000

# LLM — OpenRouter (one key for all models)
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=MultiAI

# Real source discovery — Serper is the default provider
SOURCE_DISCOVERY_PROVIDER=serper
SERPER_API_KEY=
SERPER_SEARCH_BASE_URL=https://google.serper.dev/search
SERPER_SEARCH_TIMEOUT_SECONDS=10
SERPER_SEARCH_RESULTS_PER_QUERY=10
SERPER_SEARCH_MAX_QUERIES_PER_DISCOVERY=4

# Secure source retrieval (internal service only; no arbitrary public fetch endpoint)
SOURCE_RETRIEVAL_USER_AGENT=MultiMindSourceRetrieval/1.0 (+https://multimind.local/source-retrieval)
SOURCE_RETRIEVAL_CONNECT_TIMEOUT_SECONDS=5
SOURCE_RETRIEVAL_TIMEOUT_SECONDS=15
SOURCE_RETRIEVAL_MAX_REDIRECTS=5
SOURCE_RETRIEVAL_MAX_BYTES=2097152
SOURCE_RETRIEVAL_ALLOWED_PORTS=80,443
SOURCE_RETRIEVAL_ROBOTS_POLICY=respect
SOURCE_RETRIEVAL_MAX_CANDIDATES_PER_COVERAGE_CELL=10
SOURCE_RETRIEVAL_MAX_CANDIDATES_PER_EXECUTION=150

# Real facility extraction (worker-connected; enable for staging + optional auto-publish)
FACILITY_EXTRACTION_ENABLED=true
FACILITY_EXTRACTION_MODEL=gpt-4.1
FACILITY_EXTRACTION_MAX_DOCUMENT_CHARACTERS=200000
FACILITY_EXTRACTION_CHUNK_CHARACTERS=12000
FACILITY_EXTRACTION_CHUNK_OVERLAP_CHARACTERS=500
FACILITY_EXTRACTION_MAX_CHUNKS_PER_DOCUMENT=20
FACILITY_EXTRACTION_MAX_DOCUMENTS_PER_EXECUTION=50
FACILITY_EXTRACTION_MAX_CHUNKS_PER_EXECUTION=120
FACILITY_EXTRACTION_MAX_CANDIDATES_PER_CHUNK=25
FACILITY_EXTRACTION_MAX_CANDIDATES_PER_DOCUMENT=100
FACILITY_EXTRACTION_TIMEOUT_SECONDS=60
FACILITY_EXTRACTION_MAX_ATTEMPTS=2
FACILITY_EXTRACTION_MAX_EVIDENCE_QUOTE_CHARACTERS=1000

# Auto-publish verified staging candidates into final rehab facility tables
FACILITY_PUBLICATION_ENABLED=true
FACILITY_PUBLICATION_MIN_CONFIDENCE=0.55
FACILITY_PUBLICATION_MAX_CANDIDATES_PER_EXECUTION=300

# Optional source discovery provider — Brave Search (inactive unless selected)
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search
BRAVE_SEARCH_TIMEOUT_SECONDS=20
BRAVE_SEARCH_RESULTS_PER_QUERY=10
BRAVE_SEARCH_MAX_QUERIES_PER_DISCOVERY=6

# Standalone Google Places Maps census
GOOGLE_PLACES_ENABLED=true
GOOGLE_PLACES_API_KEY=

# Maps Census missing-website backfill: llm (Perplexity Sonar web search) or serper (legacy)
MAPS_CENSUS_WEBSITE_SEARCH_MODE=llm
MAPS_CENSUS_WEBSITE_LLM_MODEL=sonar-pro
MAPS_CENSUS_WEBSITE_LLM_MIN_CONFIDENCE=0.75
MAPS_CENSUS_WEBSITE_LLM_VERIFY_REACHABLE=true
MAPS_CENSUS_WEBSITE_LLM_TIMEOUT_SECONDS=120

# Pexels — country hero photography for the Maps Census UI (server-side only)
PEXELS_API_KEY=

# Maps Census — adaptive discovery ceilings and saturation thresholds
MAPS_CENSUS_MAX_CELLS_PER_RUN=1500
MAPS_CENSUS_MAX_CELLS_PER_CAMPAIGN=1500
MAPS_CENSUS_SATURATION_WINDOW=10
MAPS_CENSUS_MIN_NEW_UNIQUE_FOR_EXPANSION=3
MAPS_CENSUS_MIN_NEW_PLAUSIBLE_FOR_EXPANSION=1

# Maps Census Phase 2 — country discovery profile (live-web terminology before grid planning)
MAPS_CENSUS_COUNTRY_PROFILE_MODEL=sonar-pro
MAPS_CENSUS_COUNTRY_PROFILE_TIMEOUT_SECONDS=90

# Maps Census Phase 2 — AI web-search enrichment for addictions + languages
MAPS_CENSUS_ENRICHMENT_ENABLED=true
MAPS_CENSUS_ENRICHMENT_MAX_PLACES_PER_RUN=250
MAPS_CENSUS_ENRICHMENT_BATCH_SIZE=5
MAPS_CENSUS_ENRICHMENT_MODEL=sonar-pro
MAPS_CENSUS_AUTO_ENRICHMENT_ENABLED=true
MAPS_CENSUS_ADMIN_UI_ENABLED=true
MAPS_CENSUS_EXTERNAL_DISCOVERY_ENABLED=false
MAPS_CENSUS_WEBSITE_CRAWL_ENABLED=true

# Chat composer attachments (text / .docx / .xlsx / .pdf)
# Size limit is in bytes; default 10485760 = 10 MB.
# Uploads are streamed with the size limit enforced during streaming.
# DOCX/XLSX/PDF are parsed server-side for text excerpts (no OCR).
# Images remain unsupported.
# Production/Docker must persist CHAT_ATTACHMENT_DIR (named volume in compose).
# Reverse proxies must allow request bodies at least as large as this limit.
CHAT_ATTACHMENT_DIR=/app/data/chat_attachments
CHAT_ATTACHMENT_MAX_BYTES=10485760
# Total characters of attachment context injected into a turn (across all files).
CHAT_ATTACHMENT_CONTEXT_MAX_CHARS=100000

# Voice transcription — local development defaults use CPU
TRANSCRIPTION_ENABLED=true
TRANSCRIPTION_MODEL=large-v3-turbo
TRANSCRIPTION_DEVICE=cpu
TRANSCRIPTION_COMPUTE_TYPE=float16
TRANSCRIPTION_CPU_MODEL=medium
TRANSCRIPTION_CPU_COMPUTE_TYPE=int8
TRANSCRIPTION_STRICT_DEVICE=false
TRANSCRIPTION_MAX_DURATION_SECONDS=1800
TRANSCRIPTION_MAX_UPLOAD_BYTES=78643200
TRANSCRIPTION_TIMEOUT_SECONDS=900
TRANSCRIPTION_TMP_DIR=/tmp/multimind-transcriptions
TRANSCRIPTION_CONCURRENCY=1
TRANSCRIPTION_MODEL_CACHE_DIR=/models/whisper
HF_HOME=/models/whisper
TRANSCRIPTION_BEAM_SIZE=1
TRANSCRIPTION_VAD_FILTER=true
TRANSCRIPTION_INITIAL_PROMPT=MultiMind, OpenRouter, Ollama, Claude, Gemini, GPT, RAG, orchestrator, scraper, blueprint, verdict, model set

# Production GPU example:
# TRANSCRIPTION_DEVICE=cuda
# TRANSCRIPTION_MODEL=large-v3-turbo
# TRANSCRIPTION_COMPUTE_TYPE=float16
# TRANSCRIPTION_STRICT_DEVICE=false

# Docker Compose interpolates OPENROUTER_API_KEY from the host .env into:
#   api, scraping-worker, and playbook-worker
# The Playbook worker runs extraction (gpt-4.1 via OpenRouter) and must receive
# the same OpenRouter key as the API. Do not put the secret in compose files.
#   docker compose up --build
